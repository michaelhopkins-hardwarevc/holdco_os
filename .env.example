# ---------------------------------------------------------------------------
# HoldCo OS — environment variables
#
# HOW TO USE:
#   1. Copy this file to `.env.local`  (that file is git-ignored — real secrets
#      never get committed).
#   2. Fill in the values by following the README "Set up the accounts" steps.
#   3. Leave the "Later phases" section blank until you reach that phase.
#
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is
# server-only — never prefix a real secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------


# === Needed now: Supabase (database + auth) ================================

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" secret key (server only — full access, keep private)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by the app at runtime (Supabase "pooled",
# port 6543). Format:
# postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL=

# Postgres DIRECT connection (port 5432) used only for running migrations.
# Format: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DIRECT_URL=


# === Needed soon: app URL ==================================================

# The public URL of the app. Locally: http://localhost:3000
# In production: your Vercel URL, e.g. https://holdco-os.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# === Later: transactional email (Resend) — Phase 1 invites/invoices ========

RESEND_API_KEY=
# The "from" address invoices and invites are sent as, e.g. HoldCo OS <noreply@yourdomain.com>
EMAIL_FROM=


# === Later: error monitoring (Sentry) ======================================

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token used at build time to upload source maps (server only)
SENTRY_AUTH_TOKEN=


# === Signals: Outlook / Microsoft Graph calendar =========================

# From the Azure app registration (see README "Connect Outlook").
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your Microsoft 365 tenant id, or "common" for any account.
MICROSOFT_TENANT=common
# 32-byte key (base64 or hex) used to encrypt stored OAuth tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=


# === WIS Day-One capture: Monday + HubSpot ================================
# Read-only tokens for the activity-capture layer. Safe to add now; the app
# only reads with them, and it won't pull until the scheduled-sync wiring is
# built. See DECISIONS.md (M1 Capture) and the chat setup steps.

# Monday personal API token (avatar -> Developers -> My Access Tokens).
MONDAY_API_TOKEN=

# HubSpot Service Key (Settings -> Integrations -> Service Keys; Super Admin).
# Read scopes only: deals, companies, contacts, engagements/activities. Service
# Keys replaced Private Apps for data-only system-to-system integrations (2026);
# it's still sent as a Bearer token, so the adapter is unchanged.
HUBSPOT_SERVICE_KEY=

# NOTE: Graph sent-mail capture reuses the MICROSOFT_* vars above, but the
# Azure app registration needs the "Mail.Read" scope added to its permissions.

# Shared secret for the daily capture cron (/api/capture/sync). Set the SAME
# value in Vercel; Vercel Cron sends it as a Bearer token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=


# === WIS M4: Xero draft-invoice export =====================================
# Xero OAuth 2.0 app (draft invoices only; a human approves + sends in Xero).
# Full OAuth wiring is a follow-up; for now the export uses a bearer token and
# the tenant (organisation) id. The tracking category whose options are your
# projects defaults to "Project".
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
XERO_TRACKING_CATEGORY=Project


# === Later phases: integrations (leave blank until that phase) =============

# Phase 2 — QuickBooks Online (per-entity OAuth)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" or "production"
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=
